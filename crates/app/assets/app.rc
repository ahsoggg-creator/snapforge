1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION SF_MAJOR,SF_MINOR,SF_PATCH,0
PRODUCTVERSION SF_MAJOR,SF_MINOR,SF_PATCH,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "CompanyName", "SnapForge"
      VALUE "FileDescription", "SnapForge"
      VALUE "ProductName", "SnapForge"
      VALUE "OriginalFilename", "SnapForge.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x419, 1200
  END
END
